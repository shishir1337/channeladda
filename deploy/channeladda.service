# /etc/systemd/system/channeladda.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now channeladda
#   sudo journalctl -u channeladda -f

[Unit]
Description=Channel Adda (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=channeladda
Group=channeladda
WorkingDirectory=/srv/channeladda/app

# next start reads .env from WorkingDirectory. Nothing secret is written here,
# so this unit file stays safe to commit.
Environment=NODE_ENV=production
Environment=PORT=3000

# Bind to loopback only. nginx is the only thing that should be able to reach
# the app; without this the site is also served on http://<vps-ip>:3000 with no
# TLS, which defeats the Secure session cookie.
Environment=HOSTNAME=127.0.0.1

ExecStart=/usr/bin/pnpm start
Restart=always
RestartSec=5

# Give in-flight requests a moment rather than cutting them off mid-deal.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=channeladda

# ---- Hardening ------------------------------------------------------------
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The app writes exactly two places: the build output and uploaded files.
ReadWritePaths=/srv/channeladda/app/.next /srv/channeladda/app/.data

[Install]
WantedBy=multi-user.target
