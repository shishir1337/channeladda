{
  "name": "channel-adda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "e2e": "node e2e/run.cjs",
    "db:up:native": "pg_ctl -D \"C:/tmp/dbpg\" -o \"-p 5434\" -l \"C:/tmp/dbpg.log\" start",
    "db:down:native": "pg_ctl -D \"C:/tmp/dbpg\" stop",
    "predev": "node scripts/ensure-db.mjs",
    "prebuild": "node scripts/ensure-db.mjs",
    "db:check": "node scripts/ensure-db.mjs",
    "typecheck": "tsc --noEmit",
    "test:repo": "tsx --conditions=react-server scripts/repo-test.ts",
    "test:auth": "tsx --conditions=react-server scripts/verify-auth.ts",
    "test": "pnpm lint && pnpm typecheck && pnpm test:repo && pnpm test:auth && pnpm test:seller && pnpm test:admin && pnpm test:settings && pnpm test:offers && pnpm test:redact && pnpm test:messages && pnpm test:users && pnpm e2e:reset && pnpm e2e",
    "test:seller": "tsx --conditions=react-server scripts/verify-seller.ts",
    "test:admin": "tsx --conditions=react-server scripts/verify-admin.ts",
    "test:settings": "tsx --conditions=react-server scripts/verify-settings.ts",
    "test:offers": "tsx --conditions=react-server scripts/verify-offers.ts",
    "test:messages": "tsx --conditions=react-server scripts/verify-messages.ts",
    "test:users": "tsx --conditions=react-server scripts/verify-admin-users.ts",
    "test:redact": "tsx --conditions=react-server scripts/verify-redact.ts",
    "e2e:reset": "tsx --conditions=react-server scripts/reset-fixtures.ts",
    "create:admin": "tsx --conditions=react-server scripts/create-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.6.5"
}
