# Production environment for channeladda.com
#
# Copy to .env on the server, fill in, then: chmod 600 .env
# This file is read by both `next build` and `next start`, so a value that is
# wrong at build time is baked into the bundle.

# ---- Database -------------------------------------------------------------
# Local Postgres over the unix-socket-less loopback. The password is whatever
# you set when creating the role; it never leaves the box.
DATABASE_URL=postgresql://channeladda:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/channeladda?schema=public

# ---- Better Auth ----------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs session cookies and email tokens. Rotating it signs everyone out.
# Losing it means nobody can sign in until you set a new one.
BETTER_AUTH_SECRET=REPLACE_WITH_32_RANDOM_BYTES

# The public origin, exactly as a browser sees it. Must be https and must not
# have a trailing slash. If this says http, or says localhost, sign-in will
# appear to work and then silently fail: the session cookie is Secure in
# production and the browser drops it when the origin does not match.
BETTER_AUTH_URL=https://channeladda.com

# ---- Site -----------------------------------------------------------------
# Used for canonical URLs, sitemaps and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://channeladda.com

# ---- Runtime --------------------------------------------------------------
NODE_ENV=production
PORT=3000
