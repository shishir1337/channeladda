// Channel Adda schema.
//
// Two state machines carry the whole product: Listing and Order. Every
// dashboard is a view onto one of them. Money is stored in integer USD cents
// and converted to dollars at the repository boundary.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Platform {
  YOUTUBE
  INSTAGRAM
  FACEBOOK
  TELEGRAM
  WEBSITE
}

enum UserRole {
  USER // buys and/or sells
  AGENT // takes custody of assets and runs transfers
  MODERATOR // listings, KYC, reports
  FINANCE // withdrawals, refunds, dispute payouts
  SUPERADMIN // fees, roles, bans
}

enum KycStatus {
  NOT_STARTED
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  CODE_CHECK // ownership code placed, awaiting verification
  ADMIN_REVIEW
  LIVE
  RESERVED // an offer was accepted, buyer is paying
  SOLD
  REJECTED
  PAUSED
  REMOVED
}

enum OfferStatus {
  OPEN
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  WITHDRAWN
}

/// The two deal shapes, with mirror-image protections.
enum DealMode {
  SAFEST // the channel is escrowed with an agent; buyer pays the seller direct
  FASTEST // the money is escrowed with the platform; it pays the seller
}

/// Coarse on purpose: this answers "whose move is it?" and little else. The
/// step-by-step choreography lives in TransferStep, seeded per mode.
enum OrderStatus {
  AWAITING_PAYMENT // both: buyer owes the opening payment
  AGENT_VERIFYING // fastest: agent checking the channel matches the listing
  AWAITING_CUSTODY // safest: seller must hand ownership to the agent
  IN_CUSTODY // safest: agent owns it, buyer inspecting
  AWAITING_BUYER_PAYMENT // safest: buyer owes the seller directly
  AWAITING_HANDOVER // both: final ownership transfer under way
  AWAITING_RELEASE // fastest: buyer has access, seller not yet paid
  COMPLETED
  PAYMENT_EXPIRED
  CANCELLED // before anything moved
  RETURNED_TO_SELLER // safest: buyer never paid, agent handed it back
  REFUNDED // fastest: platform returned the funds
  DISPUTED // a pause, not an outcome: staff resolve it onward
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_RELEASE
  RESOLVED_REFUND
  RESOLVED_PARTIAL
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  SENT
  REJECTED
}

// Every movement of value is a ledger row, so a balance is always derivable.
enum LedgerKind {
  ESCROW_HOLD // buyer funds received, held by the platform
  ESCROW_RELEASE // released to the seller on completion
  SELLER_FEE
  BUYER_FEE
  REFUND
  WITHDRAWAL
  ADJUSTMENT
  DEPOSIT // wallet top-up
}

/// What a chat attachment is. Decided from the file's own bytes, never from
/// the name or the content type the browser claimed.
enum MediaKind {
  IMAGE
  VIDEO
}

enum NotificationKind {
  MESSAGE
  OFFER
  ORDER
  LISTING
  PAYOUT
  DISPUTE
  REVIEW
}

// ---------------------------------------------------------------- accounts

model User {
  id String @id @default(cuid())

  // ---- Better Auth owns these four. Names match its defaults, so no field
  // mapping is needed in the auth config. Passwords live on Account, never here.
  email         String  @unique
  emailVerified Boolean @default(false)
  name          String
  image         String? // ImageKit URL once uploads land

  emailVerifiedAt DateTime? // when, for the audit trail — Better Auth only tracks whether

  role      UserRole  @default(USER)
  bannedAt  DateTime?
  banReason String?

  // Public seller identity. Present on anyone who has listed.
  slug       String? @unique
  country    String?
  avatarSeed String? // drives the generated avatar

  /// Better Auth's two-factor plugin owns this. Name matches its default.
  twoFactorEnabled Boolean @default(false)

  // ---- An agent's transfer identity. Only ever set on an AGENT.
  //
  // Order.agentEmail and Order.agentBrand were typed in per deal by whoever
  // assigned it, so the same agent reached different sellers under different
  // names and a seller inviting the wrong address hands a channel to nobody.
  // These are the agent's stored default, copied onto the deal at assignment.
  /// The Google account a seller is told to invite as channel owner.
  agentEmail String?
  /// Display name shown beside agentEmail, e.g. "Channel Adda Transfers".
  agentBrand String?

  kycStatus  KycStatus @default(NOT_STARTED)
  // Hash of the identity document, so a banned seller cannot re-register.
  kycDocHash String?

  /// Median first-reply time in minutes, recomputed from messages.
  responseMins Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  listings       Listing[]
  offersMade     Offer[]            @relation("OfferBuyer")
  ordersBought   Order[]            @relation("OrderBuyer")
  ordersSold     Order[]            @relation("OrderSeller")
  messages       Message[]
  buyerThreads   Conversation[]     @relation("ConversationBuyer")
  sellerThreads  Conversation[]     @relation("ConversationSeller")
  staffThreads   Conversation[]     @relation("ConversationStaff")
  reviewsGiven   Review[]           @relation("ReviewAuthor")
  reviewsGot     Review[]           @relation("ReviewSubject")
  favourites     Favourite[]
  ledger         LedgerEntry[]
  withdrawals    Withdrawal[]
  notifications  Notification[]
  auditEntries   AuditLog[]         @relation("AuditActor")
  kycSubmission  KycSubmission?
  payoutAddress  PayoutAddress?
  settingsEdits  PlatformSettings[] @relation("SettingsEditor")
  supportSent    SupportTicket[]    @relation("SupportRequester")
  supportHandled SupportTicket[]    @relation("SupportHandler")
  invitesSent    StaffInvite[]      @relation("StaffInviteAuthor")
  ordersAgented  Order[]            @relation("OrderAgent")
  stepsApproved  TransferStep[]     @relation("StepApprover")
  twoFactors     TwoFactor[]
  invoices       Invoice[]
  uploads        Upload[]

  @@index([slug])
  @@index([role])
}

/// A signed-in device. Better Auth writes these; nothing else should.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A way of signing in — the password credential, or a future social login.
/// `password` is the only place a password hash exists in this database.
model Account {
  id         String @id @default(cuid())
  accountId  String
  providerId String
  userId     String

  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Better Auth's key for a linked account (1.7.3+, as in 1.6). It refuses
  // to sign in when two rows share it, so the database refuses the second.
  @@unique([providerId, accountId])
  @@index([userId])
}

/// Single-use tokens: email confirmation and password reset.
/// A second factor. Better Auth's two-factor plugin writes these; nothing
/// else should. The secret and the backup codes are never returned to a
/// client, which is why the plugin marks them `returned: false`.
model TwoFactor {
  id                      String    @id @default(cuid())
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// An invitation to join the team.
///
/// How a teammate gets an account without a developer. A superadmin names the
/// address and the role; the invitee sets their own password, so no password
/// is ever shared, typed for somebody else or known to two people — which is
/// what makes "who sent that payout" answerable on a FINANCE account.
///
/// The token itself is not stored. Only a SHA-256 fingerprint of it is, so a
/// leaked copy of this table cannot be turned into an accepted invitation.
/// The raw token is returned once, to the superadmin who created it, and is
/// handed over out of band — there may be no mail provider configured, and a
/// link that only works once and expires is not a password.
model StaffInvite {
  id    String   @id @default(cuid())
  email String
  role  UserRole

  /// SHA-256 of the raw token, hex. Unique, so accepting is one index hit.
  tokenHash String @unique

  expiresAt DateTime

  invitedById String
  invitedBy   User   @relation("StaffInviteAuthor", fields: [invitedById], references: [id])

  acceptedAt     DateTime?
  /// The account the invitation produced. Scalar rather than a relation: it is
  /// a historical record, and nothing reads the team from this side.
  acceptedUserId String?

  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())

  @@index([email])
  @@index([acceptedAt, revokedAt])
}

model KycSubmission {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      KycStatus @default(PENDING)
  documentUrl String
  selfieUrl   String
  fullName    String
  country     String
  reviewerId  String?
  reviewNote  String?
  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
}

model PayoutAddress {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address     String
  network     String
  /// Withdrawals are locked until this passes after an address change.
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ---------------------------------------------------------------- listings

model Listing {
  id       String   @id @default(cuid())
  /// Human-readable URL key. Search is the main acquisition channel, so
  /// listings are addressed by slug rather than by opaque id.
  slug     String   @unique
  sellerId String
  seller   User     @relation(fields: [sellerId], references: [id])
  platform Platform

  handle  String
  title   String
  niche   String
  /// Main audience country, or "Global".
  country String

  /// The canonical link to the account, e.g. a YouTube channel URL. Sellers
  /// paste this and the rest is fetched from it, because a handle typed by
  /// hand is wrong often enough to matter.
  sourceUrl  String?
  /// The platform's own id for the account, e.g. a YouTube channel id. Stable
  /// across renames, which a handle is not.
  externalId String?

  audience          Int
  monetized         Boolean @default(false)
  monthlyRevenueUsd Int     @default(0) // cents
  /// Cents. Stored rather than derived from the monthly figure: this trade is
  /// seasonal, and twelve times a good month is a number nobody believes.
  yearlyRevenueUsd  Int     @default(0)

  /// The seller's own account of what this is and how it earns. Long-form and
  /// optional, because the fields above cannot carry "the audience moved from
  /// shorts to long-form in March".
  description String?

  /// Staff-only. Collected so a transfer that stalls can be unstuck by
  /// somebody phoning the seller, and never shown to a buyer — the product's
  /// whole contact-redaction rule exists to stop deals walking off-platform.
  whatsapp     String?
  /// Percentage times 10, so 7.4% is stored as 74.
  engagementBp Int
  ageYears     Int

  priceUsd    Int // cents
  wasPriceUsd Int? // cents

  /// Uploaded artwork. Stored as URLs rather than derived from the id, because
  /// in production these are files the seller supplies.
  coverUrl  String
  avatarUrl String

  /// Editorial promotion, set by an admin. The other card badges (new, price
  /// drop, hot) are derived from the row itself rather than stored.
  featured Boolean @default(false)

  status              ListingStatus @default(DRAFT)
  /// One-time code the seller places in their bio or description.
  ownershipCode       String?
  ownershipVerifiedAt DateTime?
  rejectionReason     String?

  /// Platform-specific setup that decides how a transfer runs, e.g. whether a
  /// YouTube channel sits on a Brand Account.
  transferProfile String?

  watching  Int      @default(0)
  listedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proofs        ListingProof[]
  conversations Conversation[]
  offers        Offer[]
  orders        Order[]
  favourites    Favourite[]

  @@index([status, platform])
  @@index([featured])
  @@index([platform, externalId])
  @@index([sellerId])
  @@index([platform, priceUsd])
  @@index([listedAt])
  @@index([slug])
}

model ListingProof {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url        String
  label      String
  /// Content hash — a repeat across listings is a scam signal.
  fileHash   String
  uploadedAt DateTime @default(now())

  @@index([fileHash])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

// ---------------------------------------------------------------- deals

model Offer {
  id          String      @id @default(cuid())
  listingId   String
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User        @relation("OfferBuyer", fields: [buyerId], references: [id])
  amountUsd   Int // cents
  status      OfferStatus @default(OPEN)
  /// A counter from the seller is still an offer on the same listing by the
  /// same buyer, so without this there is no way to tell whose turn it is.
  bySeller    Boolean     @default(false)
  message     String?
  /// Offers lapse so listings do not accumulate stale interest.
  expiresAt   DateTime
  counterOf   String?
  createdAt   DateTime    @default(now())
  respondedAt DateTime?
  /// The deal an accepted offer became, if it became one.
  order       Order?
  /// Its card in the conversation, and the events about it.
  messages    Message[]

  @@index([listingId, status])
  @@index([buyerId])
}

model Order {
  id        String  @id @default(cuid())
  reference String  @unique // human-facing, e.g. CA-40218
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User    @relation("OrderBuyer", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("OrderSeller", fields: [sellerId], references: [id])

  mode   DealMode    @default(SAFEST)
  status OrderStatus @default(AWAITING_PAYMENT)

  /// The accepted offer this deal was opened from, when it was. Its amount
  /// is the deal's price. Unique, so one accepted offer opens one deal.
  offerId String? @unique
  offer   Offer?  @relation(fields: [offerId], references: [id])

  /// The staff member who takes custody (Safest) or supervises (Fastest).
  agentId    String?
  agent      User?   @relation("OrderAgent", fields: [agentId], references: [id])
  /// The Google account the seller invites, shown to them with agentBrand.
  agentEmail String?
  /// Display name beside agentEmail, e.g. "Channel Adda Transfers".
  agentBrand String?

  /// The conversation this deal belongs to. Every deal has one: opening a
  /// deal creates it when the buyer never wrote to the seller.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// Safest only: where the buyer pays the seller directly, in the seller's
  /// words. Not filtered for contact details, because a bank account number
  /// is exactly what the chat filter removes — which is why this field
  /// exists. Shown to the buyer only once it is their turn to pay.
  sellerPayTo          String?
  /// When the seller last saved it.
  sellerPayToAt        DateTime?
  /// When the seller last replaced it with something different. A change
  /// after the buyer could see it is how a hijacked account redirects a
  /// payment, so the buyer is warned about one.
  sellerPayToChangedAt DateTime?

  priceUsd     Int // cents, agreed price
  buyerFeeUsd  Int // cents
  sellerFeeUsd Int // cents
  /// What the buyer actually pays: price + buyer fee.
  totalUsd     Int // cents

  /// Cryptomus invoice reference and the asset actually paid in.
  paymentRef   String?
  paymentAsset String?
  paidAt       DateTime?

  /// Buyer acknowledged that ad revenue does not transfer.
  revenueRiskAcceptedAt DateTime?

  feePaidAt         DateTime? // opening payment cleared
  custodyAt         DateTime? // safest: agent confirmed it owns the channel
  buyerPaidAt       DateTime? // safest: buyer says they paid the seller
  /// On-chain reference for the buyer-to-seller leg, so a dispute has
  /// something checkable rather than one party's word against the other's.
  buyerPaymentRef   String?
  sellerConfirmedAt DateTime? // safest: seller says the money arrived
  handoverAt        DateTime? // Fastest: the BUYER confirmed access (step 5); starts the recovery hold

  confirmedAt DateTime? // buyer pressed confirm
  /// Set from the platform's own recovery window when the buyer confirms.
  holdUntil   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps        TransferStep[]
  messages     Message[]
  dispute      Dispute?
  ledger       LedgerEntry[]
  invoices     Invoice[]
  review       Review?

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([agentId, status])
  @@index([status])
  @@index([conversationId])
}

model TransferStep {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Position in the platform's checklist.
  position    Int
  label       String
  /// Which side has to do this one.
  actor       String
  completedAt DateTime?
  proofUrl    String?

  /// Set when a second staff member signed off a step that required it.
  approvedById String?
  approvedBy   User?   @relation("StepApprover", fields: [approvedById], references: [id])

  @@unique([orderId, position])
}

/// One negotiation, between one buyer and one seller, about one listing.
///
/// There is no direct buyer-to-seller channel anywhere in this product. Every
/// message belongs to a conversation, every conversation is tied to a listing,
/// and staff can read and join any of them. That is deliberate: a private
/// channel is where a deal walks off the platform and the protection walks
/// with it.
model Conversation {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User    @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  /// Every deal opened in this conversation, oldest first by createdAt. A
  /// deal that lapses leaves the buyer free to open another here, so this is
  /// many deals to one thread — a single link on the thread could hold only
  /// the first, and the second then had no conversation at all.
  orders Order[]

  /// The staff member handling it. Any staff can read; this one owns it.
  staffId String?
  staff   User?   @relation("ConversationStaff", fields: [staffId], references: [id], onDelete: SetNull)

  /// Raised to staff because someone tried to swap contact details.
  flaggedAt     DateTime?
  flagReason    String?
  lastMessageAt DateTime  @default(now())
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  messages Message[]

  /// One thread per buyer per listing — not one per question.
  @@unique([listingId, buyerId])
  @@index([sellerId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
  @@index([flaggedAt])
}

/// What an entry in a conversation is.
///
/// The conversation is the record of a deal, so an offer and every step of
/// the deal appear in it at the moment they happened, whichever page they
/// were done from — written by the server function that made the change.
enum MessageKind {
  TEXT // somebody typed it
  OFFER // an offer card; it reads its live state from `offerId`
  EVENT // one line of history: "accepted", "payment received", a step done
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// Null for what the platform does by itself — a payment clearing, a
  /// window lapsing — where there is nobody to attribute it to. Restrict, as
  /// when the column was required: SetNull, the default for an optional
  /// relation, would quietly turn a deleted user's messages into ones that
  /// read as Channel Adda's own.
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: Restrict)

  kind    MessageKind @default(TEXT)
  /// The offer an OFFER card shows, or an EVENT is about.
  offerId String?
  offer   Offer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  /// The deal an EVENT is about. A conversation can hold several.
  orderId String?
  order   Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// What everyone sees. Contact details are already stripped out of this.
  body String

  /// An attached photo or clip. Deliberately short-lived: a marketplace chat
  /// accumulates screenshots of dashboards, bank pages and ID documents, and
  /// keeping them for ever turns a support tool into a breach waiting to
  /// happen. The file is deleted from disk when it expires and these go null.
  attachmentUrl       String?
  attachmentKind      MediaKind?
  attachmentBytes     Int?
  /// When the file gets deleted. Set on upload, not derived, so changing the
  /// policy later does not retroactively destroy what people already sent.
  attachmentExpiresAt DateTime?
  attachmentRemovedAt DateTime?

  /// Set when contact details were removed on the way in. The original is
  /// never stored: keeping it would recreate the private channel in the
  /// database.
  redactedAt    DateTime?
  /// What was stripped, e.g. "an email address", for staff to act on.
  redactedKinds String?

  /// True for a note written by staff, which both sides can see.
  fromStaff Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@index([attachmentExpiresAt])
  @@index([createdAt])
  @@index([offerId])
  @@index([orderId])
}

model Dispute {
  id         String        @id @default(cuid())
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedById String
  reason     String
  detail     String
  status     DisputeStatus @default(OPEN)

  reviewerId String?
  decision   String?
  /// On a partial settlement, what the buyer got back.
  refundUsd  Int?

  openedAt     DateTime  @default(now())
  firstReplyAt DateTime?
  resolvedAt   DateTime?

  @@index([status])
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  subjectId String
  subject   User     @relation("ReviewSubject", fields: [subjectId], references: [id])
  rating    Int // 1-5
  body      String
  createdAt DateTime @default(now())

  @@index([subjectId])
}

// ---------------------------------------------------------------- money

model LedgerEntry {
  id          String     @id @default(cuid())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id])
  kind        LedgerKind
  /// Signed cents. Positive credits the user, negative debits them.
  amountUsd   Int
  note        String?
  /// The processor's own reference for money arriving from outside, unique so
  /// a retried callback cannot credit the same deposit twice. Null for every
  /// internal movement, and Postgres treats each null as distinct.
  externalRef String?    @unique
  createdAt   DateTime   @default(now())

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([kind])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  amountUsd   Int // cents
  address     String
  network     String
  status      WithdrawalStatus @default(REQUESTED)
  /// Set by Cryptomus once broadcast.
  txHash      String?
  reviewerId  String?
  rejectNote  String?
  requestedAt DateTime         @default(now())
  settledAt   DateTime?

  @@index([status])
  @@index([userId])
}

// ---------------------------------------------------------------- ops

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

/// Immutable record of every admin action. The only defence when a seller
/// claims they were not paid, and the only way to catch an inside job.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([entity, createdAt])
  @@index([actorId, createdAt])
}

/// A message from the contact form.
///
/// `userId` is nullable because the people who most need support are often the
/// ones who cannot sign in — a suspended account, a forgotten password, a
/// hijacked email. Requiring a session here would lock out exactly them.
model SupportTicket {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation("SupportRequester", fields: [userId], references: [id], onDelete: SetNull)

  /// Where the reply goes. Captured even for signed-in people, since they may
  /// be writing precisely because they have lost access to the account one.
  email    String
  topic    String
  orderRef String?
  message  String

  status      SupportStatus @default(OPEN)
  handledById String?
  handledBy   User?         @relation("SupportHandler", fields: [handledById], references: [id], onDelete: SetNull)
  handledAt   DateTime?
  staffNote   String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

enum SupportStatus {
  OPEN
  ANSWERED
  CLOSED
}

model Report {
  id         String    @id @default(cuid())
  reporterId String
  entity     String // "listing" | "user"
  entityId   String
  reason     String
  detail     String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([entity, entityId])
}

/// Platform-wide numbers a superadmin can change without a deploy.
///
/// One row, always id "singleton". Rates are basis points — 300 is 3.00% — so
/// a rate is an integer and can never arrive as 0.030000000000000002.
///
/// Changing these never rewrites history: an Order stores the fee it was
/// charged in cents, so a rate change moves the next sale, not the last one.
/// A file this app stored, and who put it there.
///
/// Two things needed it. The serving route gates proof screenshots and chat
/// attachments, and without a record of the uploader a person could not see
/// their own file until something else referenced it — so every preview in a
/// half-finished form was broken. And an upload that is never attached to
/// anything was never collected, which let any signed-in account fill the
/// disk with 25MB clips through the upload endpoint alone.
model Upload {
  id  String @id @default(cuid())
  /// The storage key, e.g. `message/<32 hex>.png`. Generated, never supplied.
  key String @unique

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  kind        String
  bytes       Int
  contentType String

  /// Set once something points at this file. Null means it is an orphan and
  /// the sweep may collect it.
  attachedAt DateTime?

  createdAt DateTime @default(now())

  @@index([uploaderId])
  @@index([attachedAt, createdAt])
}

/// What an invoice was raised for.
enum InvoicePurpose {
  DEAL
  TOPUP
}

/// An invoice raised with the payment processor.
///
/// Written when the invoice is created, which is the only moment we know for
/// certain who it belongs to and what it was for. Without it a top-up callback
/// had to recover its payee from an eight-character slice of the reference by
/// scanning the user table, and a callback whose handler failed left no trace
/// that money had ever been asked for — so nothing could reconcile it and the
/// deal quietly expired with the buyer out of pocket.
model Invoice {
  id String @id @default(cuid())

  /// Our reference, which is what the processor echoes back.
  reference String         @unique
  purpose   InvoicePurpose
  amountUsd Int // cents

  /// Who it belongs to. A top-up has no order, so this is the only link.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Set for a deal invoice.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// The processor's own id, once it tells us.
  externalId String?
  /// Last status seen on a callback, for the reconciliation sweep to read.
  lastStatus String?
  settledAt  DateTime?
  /// Set once the money has actually been applied to a balance or a deal, so
  /// reconciliation knows the difference between paid and paid-and-handled.
  appliedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purpose, appliedAt])
  @@index([userId])
  @@index([orderId])
}

model PlatformSettings {
  id String @id @default("singleton")

  /// Added on top of the listing price, paid by the buyer. Per mode: Fastest
  /// is more work and carries the funds, so it may be priced higher.
  buyerFeeBpSafest  Int @default(300)
  buyerFeeBpFastest Int @default(300)
  /// Deducted before a Fastest seller is credited. A Safest sale cannot be
  /// charged one: the price never passes through the platform.
  sellerFeeBp       Int @default(0)

  /// How many Safest channels one agent may hold at once. Google caps how many
  /// channels an account can own, and a locked agent account freezes each deal
  /// it is holding.
  maxHoldsPerAgent       Int @default(10)
  /// At or above this price, the step that hands value across needs a second
  /// staff approval. Cents.
  secondApprovalAboveUsd Int @default(500000)

  /// How long an offer stands before it lapses. Stops listings accumulating
  /// stale interest that neither side ever closes out.
  offerExpiryHours Int @default(48)

  /// The smallest withdrawal finance will send. Cents. A crypto payout pays
  /// the chain's fee whatever its size, so below some figure the seller is
  /// paying more to receive the money than the money is worth — and the
  /// figure depends on the network, so it is a setting, not a constant.
  minWithdrawalUsd Int @default(2000)

  /// How long an unpaid deal holds its listing before it lapses. Was a
  /// constant, and it is the one most likely to need tuning: it decides how
  /// long a buyer who walked away keeps a listing off the market.
  paymentWindowHours Int @default(48)

  /// When the scheduled sweep last finished, and what it did. A dead
  /// crontab was silent before this, and its documented consequence is
  /// listings reserved for ever and payments never reconciled.
  lastSweepAt     DateTime?
  lastSweepResult Json?

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SettingsEditor", fields: [updatedById], references: [id])
}
