# Copy to .env and fill in. Never commit the real file.

# The password sits inside a URL, so it must not contain a raw / @ # : ? or %
# — those break parsing with a confusing "invalid port number" error.
# Generate one with:  openssl rand -base64 32 | tr -d '/+=@#:?%'
DATABASE_URL=postgresql://channeladda:PASSWORD@127.0.0.1:5432/channeladda?schema=public

# Signs session cookies. Generate, don't invent. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The public origin exactly as a browser sees it — no trailing slash.
# In production this must be https, or sign-in silently fails: session cookies
# are Secure and the browser drops them when the origin doesn't match.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Development only -----------------------------------------------------
# Both of these are throwaway databases. Leave them unset in production:
# `prisma migrate deploy` never reads either, and pointing them at a real
# database would destroy it.

# `prisma migrate dev` and `prisma migrate diff --from-migrations` replay the
# migration history into this one to work out a schema diff, dropping and
# recreating it each time.
SHADOW_DATABASE_URL=postgresql://channeladda:PASSWORD@127.0.0.1:5433/channeladda_shadow?schema=public

# What `pnpm test` runs against. The suite TRUNCATEs every table between
# tests, so this must name a database you are happy to lose. The harness in
# src/test/db.ts refuses to run if it is unset or equal to DATABASE_URL.
DATABASE_URL_TEST=postgresql://channeladda:PASSWORD@127.0.0.1:5433/channeladda_test?schema=public

# ---- Payments (Cryptomus) --------------------------------------------------
# From the Cryptomus dashboard: Merchant settings -> API keys. The payment key
# signs outgoing requests AND verifies incoming webhooks, so it is the one
# secret that decides whether a deal can be funded. Leave both unset and the
# product falls back to the finance desk recording payments by hand.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_PAYMENT_KEY=

# The webhook URL to register with Cryptomus is built from NEXT_PUBLIC_SITE_URL:
#   https://your-domain/api/webhooks/cryptomus
# Cryptomus posts from 91.227.144.54 — worth allowing only that IP at the
# proxy, in addition to the signature check the route already does.

# ---- Scheduled sweep ------------------------------------------------------
# Guards POST /api/cron, which expires unpaid deals and lapsed offers. Without
# it the endpoint is closed, and abandoned deals hold listings off the market.
# Generate with: openssl rand -base64 32
# Call it from a crontab or systemd timer, every 10 minutes:
#   curl -fsS -X POST https://your-domain/api/cron -H "authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# ---- Google sign-in -------------------------------------------------------
# From the Google Cloud console: APIs & Services -> Credentials -> OAuth 2.0
# client ID, type "Web application". Add this exact redirect URI:
#   https://your-domain/api/auth/callback/google
# and http://localhost:3000/api/auth/callback/google for local work.
# Only openid, email and profile are requested — a marketplace has no business
# holding a token that can read somebody's YouTube account.
# Leave both unset and the Google button is not rendered at all, rather than
# being drawn and failing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- YouTube lookups ------------------------------------------------------
# From the Google Cloud console: enable "YouTube Data API v3", then create an
# API key under Credentials. Restrict it to that one API.
#
# Used for two things: filling a listing in from a pasted channel link (name,
# avatar, subscriber count), and reading the channel description back to check
# the ownership code the seller placed there.
#
# Quota is 10,000 units a day. A lookup by channel id or @handle costs 1 unit;
# an old-style /c/ or /user/ link has no direct lookup and the seller is asked
# for the modern link rather than being charged 100 units for a search.
#
# Without it both paths still work, more slowly: the seller types the figures
# and a moderator reads the description themselves.
YOUTUBE_API_KEY=
