# Copy to .env and fill in. Never commit the real file.

# The password sits inside a URL, so it must not contain a raw / @ # : ? or %
# — those break parsing with a confusing "invalid port number" error.
# Generate one with:  openssl rand -base64 32 | tr -d '/+=@#:?%'
DATABASE_URL=postgresql://channeladda:PASSWORD@127.0.0.1:5432/channeladda?schema=public

# Signs session cookies. Generate, don't invent. Rotating it signs everyone out.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The public origin exactly as a browser sees it — no trailing slash.
# In production this must be https, or sign-in silently fails: session cookies
# are Secure and the browser drops them when the origin doesn't match.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
