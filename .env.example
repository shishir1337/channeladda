# Copy to .env and fill in. Never commit the real file.

# ---- Database -------------------------------------------------------------
DATABASE_URL=postgresql://channeladda:channeladda_dev@127.0.0.1:5434/channeladda?schema=public

# ---- Better Auth ----------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Signs session cookies and verification tokens. Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# The public origin. Must match where the app is actually served.
BETTER_AUTH_URL=http://localhost:3000
